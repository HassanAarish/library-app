# LibraryHub mobile — copy to .env and adjust.
# Only EXPO_PUBLIC_* variables reach the app, and anyone with the app can read
# them: never put secrets here.

# Backend API (and Socket.IO). Leave empty in development: the app then uses
# the backend on the computer running `npm start`, port 5001.
EXPO_PUBLIC_API_URL=
# EXPO_PUBLIC_SOCKET_URL=

# The website (legal pages, account help). Links to it are hidden when empty.
EXPO_PUBLIC_SITE_URL=https://<your-domain>

# Android package id — permanent once published on Google Play.
# ANDROID_PACKAGE=pk.libraryhub.app
